<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="TextAppearance.Sporta.Heading1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/sporta_charcoal</item>
    </style>

    <style name="TextAppearance.Sporta.Heading2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/sporta_charcoal</item>
    </style>

    <style name="TextAppearance.Sporta.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sporta_text_secondary</item>
    </style>

    <style name="TextAppearance.Sporta.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/sporta_text_secondary</item>
    </style>

    <style name="Widget.Sporta.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sporta_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Sporta.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/sporta_charcoal</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/sporta_charcoal</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Sporta.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/box_stroke_color</item>
        <item name="hintTextColor">@color/sporta_red</item>
    </style>

    <style name="TextAppearance.Sporta.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Sporta.ToolbarSubtitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Sporta.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
    </style>

</resources>