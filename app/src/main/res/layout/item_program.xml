<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/sporta_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Garis warna di kiri, warnanya mengikuti level -->
        <View
            android:id="@+id/viewStrip"
            android:layout_width="6dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/sporta_charcoal"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewStrip"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Spartan Pemula" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/sporta_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/tvNama"
            app:layout_constraintStart_toStartOf="@id/tvNama"
            app:layout_constraintTop_toBottomOf="@id/tvNama"
            tools:text="7 hari · 15 menit per hari · 6 gerakan" />

        <TextView
            android:id="@+id/tvDeskripsi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/sporta_charcoal"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/tvNama"
            app:layout_constraintStart_toStartOf="@id/tvNama"
            app:layout_constraintTop_toBottomOf="@id/tvInfo"
            tools:text="Pengenalan gerakan dasar untuk memulai kebiasaan latihan." />

        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/btnMulai"
            app:layout_constraintStart_toStartOf="@id/tvNama"
            app:layout_constraintTop_toTopOf="@id/btnMulai"
            tools:text="Pemula" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMulai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/sporta_red"
            android:fontFamily="@font/inter_semibold"
            android:text="Mulai"
            android:textColor="@color/white"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tvNama"
            app:layout_constraintTop_toBottomOf="@id/tvDeskripsi" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>